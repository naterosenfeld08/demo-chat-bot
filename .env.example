# Copy this file to .env and fill in real values.
#   cp .env.example .env
# .env is git-ignored. Never commit it. Never paste a real key into any other file.

# --- Required: the AI service this app calls at runtime ---
# This is NOT the key your coding assistant uses in the editor. That one lives in
# your editor's settings, not in this repo.
# Create a key at https://app.tensorx.ai/dashboard/keys
TENSORX_API_KEY=

# --- Optional: which model to use. Defaults to the value below if unset. ---
TENSORX_MODEL=z-ai/glm-5.2

# --- Deployment ---
# On Render, paste these into the service's Environment settings rather than
# uploading .env. See docs/deploying.md.
